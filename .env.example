# TradingGuard backend environment example
# PAPER ONLY during validation. Keep future broker credentials only on the backend runtime environment.
APP_ENV=development
DATABASE_URL=sqlite:///./data/tradingguard.db
LOG_LEVEL=INFO

# Comma-separated frontend origins allowed to call the FastAPI backend.
# Local example:
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend build-time setting. In cloud, set this to the deployed TradingGuard API origin.
# Example: VITE_API_URL=https://tradingguard-api.example.com
VITE_API_URL=http://localhost:8000
